# =====================================================================
# CabGo realtime server (Express + Socket.IO) — copy to server/.env
# =====================================================================
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to open sockets (your Vercel domain(s)).
CORS_ORIGINS=http://localhost:3000

# Clerk — verifies the session token every browser sends when it connects.
CLERK_SECRET_KEY=your_clerk_secret_key

# Supabase — service role (server only!). Used to look up users and persist ride breadcrumbs.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# Shared secret: the Next.js app sends it as `x-internal-secret` when it pushes events.
# Must match REALTIME_INTERNAL_SECRET in the Next.js environment (min 16 characters).
REALTIME_INTERNAL_SECRET=change-me-to-a-long-random-string

# Firebase Admin (optional — enables the Realtime Database mirror + custom sign-in tokens).
# Leave all four empty to run on Socket.IO + Supabase only.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences and wrap the key in double quotes
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
