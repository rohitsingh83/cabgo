{
  "name": "cabgo",
  "version": "1.0.0",
  "private": true,
  "description": "CabGo \u2014 a production-ready Uber/Ola/Rapido-style cab booking platform",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "seed": "tsx supabase/seed.ts",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "dev:all": "concurrently -n web,server -c blue,green \"npm run dev\" \"npm run server:dev\"",
    "server:test": "npm --prefix server run test",
    "server:typecheck": "npm --prefix server run typecheck",
    "check:all": "npm run typecheck && npm run lint && npm run server:typecheck && npm run server:test",
    "build:all": "npm run build && npm run server:build",
    "pre-deploy": "tsx scripts/pre-deploy-check.ts",
    "verify": "npm run check:all && npm run build:all && npm run pre-deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^4.5.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-autoplay": "^8.3.0",
    "embla-carousel-react": "^8.3.0",
    "firebase": "^10.13.2",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.446.0",
    "next": "14.2.15",
    "next-themes": "^0.3.0",
    "nodemailer": "^6.9.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "resend": "^4.0.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.0",
    "stripe": "^16.12.0",
    "svix": "^1.34.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
