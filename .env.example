# =====================================================================
# CabGo — environment variables
# Copy this file to `.env.local` and fill in every value.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CabGo
# Currency used for fares & Stripe (ISO 4217, lowercase for Stripe). INR for India.
NEXT_PUBLIC_CURRENCY=inr
NEXT_PUBLIC_CURRENCY_SYMBOL=₹

# ---------------------------------------------------------------------
# Clerk (https://dashboard.clerk.com) — enable Email, Phone, Google, GitHub
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
# Webhook signing secret from Clerk Dashboard → Webhooks (endpoint: /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ---------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard → Project Settings → API)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# SERVER ONLY — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role
# Storage buckets (created by the migration)
NEXT_PUBLIC_SUPABASE_AVATAR_BUCKET=avatars
NEXT_PUBLIC_SUPABASE_RECEIPT_BUCKET=receipts

# ---------------------------------------------------------------------
# Firebase Realtime Database (live driver location persistence)
# Firebase Console → Project settings → General → Your apps (Web)
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# Firebase Admin — used ONLY by the Express server (set these in server/.env, see server/.env.example;
# the Next.js app never reads them). Listed here for reference. Project settings → Service accounts
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences, wrap the whole key in double quotes
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/test/apikeys)
# ---------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints this
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# Google Maps Platform — enable: Maps JavaScript, Places, Directions,
# Geocoding, Distance Matrix APIs
# ---------------------------------------------------------------------
# Browser key — restrict by HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional Map ID (cloud-based map styling / advanced markers)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Server key — restrict by IP. Used by /api/fare-estimate and /api/geocode
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# Express + Socket.IO realtime server (see /server)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Shared secret so Next.js API routes can call the Express server's /realtime/* endpoints
REALTIME_INTERNAL_SECRET=change-me-to-a-long-random-string
# Express server URL as seen from the Next.js server
REALTIME_SERVER_URL=http://localhost:4000

# ---------------------------------------------------------------------
# Email (receipts) — choose "resend" or "smtp"
# ---------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="CabGo <receipts@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# ---------------------------------------------------------------------
# SOS SMS (optional — if unset, alerts are only stored in the DB)
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+10000000000

# ---------------------------------------------------------------------
# Business rules (can be tuned without code changes)
# ---------------------------------------------------------------------
MATCHING_RADIUS_KM=5
MATCHING_EXPANDED_RADIUS_KM=10
MATCHING_TIMEOUT_SECONDS=30
FREE_CANCELLATION_SECONDS=120
CANCELLATION_FEE=50
PLATFORM_COMMISSION_PERCENT=20

# ---------------------------------------------------------------------
# Optional / tooling
# ---------------------------------------------------------------------
# Only if you use a Clerk JWT *template* (legacy Supabase integration). Leave empty when using
# Clerk's native Supabase integration (Supabase → Auth → Third-party auth → Clerk).
NEXT_PUBLIC_CLERK_SUPABASE_JWT_TEMPLATE=
# `npm run seed` — optionally link the seeded admin to YOUR real Clerk user (Clerk → Users → copy ID)
SEED_ADMIN_CLERK_ID=
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
# Region bias for geocoding (ccTLD, e.g. in, us, gb)
NEXT_PUBLIC_MAPS_REGION=in
# Shown in the footer and support page
NEXT_PUBLIC_SUPPORT_EMAIL=support@cabgo.app

# ---------------------------------------------------------------------
# Rate limiting (optional but recommended in production)
# Without these, limits are counted in memory per server instance (fine for dev / a single
# instance, NOT shared across Vercel's serverless lambdas). Create a free Upstash Redis
# database (https://console.upstash.com) and paste the REST credentials.
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------
# Phone numbers
# ---------------------------------------------------------------------
# Country calling code prepended to emergency-contact numbers entered without a "+" (SOS SMS).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91
